#!/bin/sh
# Controlli automatici a ogni commit della repo memory.

# raw/ è immutabile: si possono aggiungere file, non modificarli/cancellarli/rinominarli.
BLOCCATI=$(git diff --cached --name-status --diff-filter=MDR -- raw/)
if [ -n "$BLOCCATI" ]; then
  echo "$BLOCCATI"
  echo "raw/ è immutabile: si aggiungono solo file nuovi"
  exit 1
fi

# lunghezza, date, link e citazioni (sceglie da solo python o python3)
exec sh strumenti/controlli.sh
