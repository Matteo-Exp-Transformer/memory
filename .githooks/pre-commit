#!/bin/sh
# Controlli automatici a ogni commit della repo memory.
# python3 su questo PC è l'alias vuoto del Microsoft Store: uso python (o py).
PY=$(command -v python || command -v py)
if [ -z "$PY" ]; then
  echo "pre-commit: python non trovato" >&2
  exit 1
fi

# 1) raw/ è immutabile: si possono aggiungere file, non modificarli/cancellarli/rinominarli.
BLOCCATI=$(git diff --cached --name-status --diff-filter=MDR -- raw/)
if [ -n "$BLOCCATI" ]; then
  echo "$BLOCCATI"
  echo "raw/ è immutabile: si aggiungono solo file nuovi"
  exit 1
fi

# 2) lunghezza, date e link
"$PY" strumenti/controlla.py . || exit 1

# 3) numeri e citazioni devono comparire alla lettera nei raw (esce 0 anche con soli "sospetti")
"$PY" .claude/skills/karpathy-llm-wiki/scripts/check_evidence.py . || exit 1
